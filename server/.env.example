MONGODB_URI=mongodb://127.0.0.1:27017/class-record
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000

# Email through Brevo (optional). Without these, temporary passwords are only shown on screen.
# API key: Brevo → SMTP & API → API keys. The sender must be verified in Brevo (Senders, domains & IPs).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=NU MOA Class Record
# Address of the app, used for the sign-in link in emails.
APP_URL=http://localhost:5173
